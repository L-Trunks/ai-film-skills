{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Ref2VA 权重 —— 与 FL2VA 是两个文件，参考音频/多图只有这个支持" }
  },
  "2": {
    "class_type": "CLIPLoaderGGUF",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3-Q4_K_M.gguf",
      "type": "minimax"
    },
    "_meta": { "title": "type 必须 minimax，填错静默退回 SD 类型" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "5": {
    "class_type": "LoadAudio",
    "inputs": { "audio": "voice_ref.wav" },
    "_meta": { "title": "音色参考 —— 放进 ComfyUI/input/" }
  },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "",
      "width": 736,
      "height": 416,
      "length": 124,
      "ref_image_size": "match",
      "ref_audios": { "ref_audio_0": ["5", 0] }
    },
    "_meta": { "title": "★ 比 I2V 多一个 audio_vae 输入。参考素材是 COMFY_AUTOGROW 类型，API 格式下要传【字典】不是平铺键：ref_audios: {ref_audio_0: [...]}。写成 ref_audio_0 会报 unexpected keyword argument（踩过）" }
  },
  "7": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["1", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0 }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "9": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 1 }
  },
  "10": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["1", 0], "conditioning": ["6", 0] }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["9", 0], "guider": ["10", 0], "sampler": ["8", 0],
      "sigmas": ["7", 0], "latent_image": ["6", 1]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["3", 0] }
  },
  "13": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["11", 0], "vae": ["4", 0] }
  },
  "14": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["12", 0], "audio": ["13", 0], "fps": 24 }
  },
  "15": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["14", 0],
      "filename_prefix": "video/H3_R2V",
      "format": "auto",
      "codec": "auto"
    }
  }
}
