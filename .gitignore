# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# 运行时产物 —— 这些是我这台机器跑出来的，不是仓库内容
*.log
*.mp4
*.png
*.jpg
*.wav
*.mp3
!docs/**/*.png
!docs/**/*.jpg
# README 里的预览片，已压到 web 档，全部 ≤4 MB
# 注意：gitignore 不支持行尾注释，注释必须单独占一行
!docs/**/*.mp4

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

